# Create a Gemini API key in https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted when GEMINI_API_KEY is empty.
# Cloud chat model, checked against the allowlist in src/backend/config.py:
# gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.6-flash, gemini-3.7-flash,
# gemini-3.8-flash, deepseek-flash, gpt-6-luna, and self-hosted vLLM models
# qwen3.8-27b (VLLM_BASE_URL), qwen3.5-2b (VLLM_QWEN3_5_2B_URL), qwen3.5-4b (VLLM_QWEN3_5_4B_URL).
CHAT_MODEL=gemini-3.5-flash-lite
# Embedding model: gemini-embedding-2 (768d), text-embedding-3-small (1536d),
# text-embedding-3-large (3072d). Dimensions and the Chroma collection name
# (cv_<model>_<dims>_v1) follow from the model; leave CHROMA_COLLECTION unset.
EMBEDDING_MODEL=gemini-embedding-2
# Keys are checked only for the providers of the chosen chat/embedding models.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# vLLM OpenAI-compatible endpoint for qwen3.8-27b; VLLM_API_KEY only if the server uses --api-key.
VLLM_BASE_URL=http://127.0.0.1:8022/v1
VLLM_API_KEY=
GEMINI_TIMEOUT_SECONDS=60
# SDK retries for embeddings only (429 uses 10s/20s/40s + jitter backoff instead).
GEMINI_MAX_RETRIES=1
# Client-side pacing for Gemini chat models only (10 RPM = one request per 6 s,
# the free-tier limit; only 1..10 accepted).
GEMINI_MAX_RPM=10
# Phase 2: one embedding request and one bulk Chroma upsert per group.
EMBED_BATCH_SIZE=20
# Local fallback for extraction on 429/timeout. Any Qwen tag, e.g. qwen3:4b.
# Run: ollama pull qwen2.5:3b
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
# Shared input cap for both providers so the prompt fits OLLAMA_NUM_CTX.
LLM_INPUT_MAX_CHARS=8000
# Extraction attempts per CV: 1 = no retry, 2 = retry once with missing fields in the prompt.
MAX_EXTRACT_ATTEMPTS=2
DATA_DIR=./data
CHROMA_DIR=./data/chroma
# CHROMA_COLLECTION is derived from EMBEDDING_MODEL; set it only to the matching name.
# Experimental threshold; recalibrate for the Gemini embedding space.
MIN_SIMILARITY=0.55
