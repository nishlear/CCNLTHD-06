# Create a Gemini API key in https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted when GEMINI_API_KEY is empty.
# Fixed dual-model baseline: these three model values are validated at startup
# and any other value is rejected.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=60
# SDK retries for embeddings only (429 uses 10s/20s/40s + jitter backoff instead).
GEMINI_MAX_RETRIES=1
# Client-side pacing for gemini-3.5-flash-lite (12 RPM = one request per 5 s).
GEMINI_MAX_RPM=12
# Phase 2: one embedding request and one bulk Chroma upsert per group.
EMBED_BATCH_SIZE=20
# Local fallback for extraction on 429/timeout. Run: ollama pull qwen2.5:3b
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
# Shared input cap for both providers so the prompt fits OLLAMA_NUM_CTX.
LLM_INPUT_MAX_CHARS=8000
DATA_DIR=./data
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=cv_gemini_embedding_2_768_v1
# Experimental threshold; recalibrate for the Gemini embedding space.
MIN_SIMILARITY=0.55
